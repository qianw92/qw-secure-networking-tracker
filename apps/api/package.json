{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Network Tracker. Validates input and forwards the caller's token to the Neon Data API.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx --env-file-if-exists=.env.local src/server.ts"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}

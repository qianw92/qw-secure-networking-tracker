# ---------------------------------------------------------------------------
# Copy to .env.local and fill in from your Neon project:
#   cp .env.example .env.local
#
# Note what is NOT here: no DATABASE_URL, no password, no API key. This
# service holds no database credential. It forwards the caller's login token
# to the Neon Data API, so there is nothing here to leak.
# ---------------------------------------------------------------------------

# The Neon Data API endpoint this service forwards requests to.
NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1

# Comma-separated list of origins allowed to call this API from a browser.
# Add your deployed frontend domain here in production.
ALLOWED_ORIGINS=http://localhost:5173

# --- Used only by the two-account isolation test; leave blank to skip it ---
NEON_AUTH_URL=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

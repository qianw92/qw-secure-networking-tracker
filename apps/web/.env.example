# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values from your Neon project.
#   cp .env.example .env.local
#
# Everything here is PUBLIC. Vite bundles any variable matching the
# NEXT_PUBLIC_ prefix into the JavaScript sent to every visitor's browser.
# Never put a password, connection string, or API secret in this file.
#
# These URLs are safe to expose because Row Level Security in Postgres decides
# what each signed-in user may read or write. See db/schema.sql.
# ---------------------------------------------------------------------------

# Neon Managed Better Auth endpoint. Handles sign-up, sign-in, and sessions.
NEXT_PUBLIC_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth

# Neon Data API endpoint. The REST interface to the contacts table.
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
# The backend API (apps/api). In local development this is the Express server
# on port 8787; in production it is the API's own Vercel deployment.
#
# All contact reads and writes go through here so that validation runs on a
# server the user cannot edit. The Data API URL above is still used for
# authentication, and remains safe for the reason given at the top.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
